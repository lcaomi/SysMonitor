<Window x:Class="PerfMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PerfMonitor.App.Views"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        Opacity="0.95"
        Width="300" MinWidth="240" MinHeight="100"
        Left="1200" Top="80">

    <Border x:Name="MainBorder"
            CornerRadius="12"
            Background="#E8161C28"
            BorderBrush="#33FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#88000000" BlurRadius="12" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="12,8,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar with settings gear -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="SysMonitor"
                           Foreground="#88FFFFFF"
                           FontSize="11"
                           FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="SettingsGear"
                           Text=""
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           Foreground="#88FFFFFF"
                           Cursor="Hand"
                           HorizontalAlignment="Right"
                           Margin="0,0,0,0"
                           MouseLeftButtonDown="SettingsGear_Click"/>
            </StackPanel>

            <!-- Metrics panel - populated dynamically -->
            <StackPanel x:Name="MetricsPanel" Grid.Row="1"/>
        </Grid>
    </Border>
</Window>
