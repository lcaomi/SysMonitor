<Window x:Class="PerfMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        Opacity="0.95"
        Width="280" Height="180"
        Left="1200" Top="80">

    <Border x:Name="MainBorder"
            CornerRadius="12"
            Background="#E8161C28"
            BorderBrush="#33FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#88000000" BlurRadius="12" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar / drag handle -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="SysMonitor"
                           Foreground="#88FFFFFF"
                           FontSize="11"
                           FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            FlowDirection="RightToLeft" Margin="0,0,0,0">
                    <!-- Manual positioning via a right-aligned panel -->
                </StackPanel>
            </StackPanel>

            <!-- Metrics display -->
            <StackPanel x:Name="MetricsPanel" Grid.Row="1">
                <!-- CPU -->
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text=""
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="#FF00B7C3"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="CPU"
                               Grid.Column="1"
                               Foreground="#CCFFFFFF"
                               FontSize="13"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                    <TextBlock x:Name="CpuValue"
                               Grid.Column="2"
                               Foreground="#FFFFFFFF"
                               FontSize="13"
                               FontFamily="Segoe UI"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="--"/>
                </Grid>

                <!-- Memory -->
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text=""
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="#FFFFB900"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="MEM"
                               Grid.Column="1"
                               Foreground="#CCFFFFFF"
                               FontSize="13"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                    <TextBlock x:Name="MemValue"
                               Grid.Column="2"
                               Foreground="#FFFFFFFF"
                               FontSize="13"
                               FontFamily="Segoe UI"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="--"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
