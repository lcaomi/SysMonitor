<Window x:Class="PerfMonitor.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="380" Height="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#FF1E1E2E"
        Foreground="#FFCDD6F4">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFCDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFCDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF89B4FA"/>
            <Setter Property="Margin" Value="0,12,0,8"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF313244"/>
            <Setter Property="Foreground" Value="#FFCDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16">
            <TextBlock Text="Settings" FontSize="18" FontWeight="Bold"
                       Foreground="#FFFFFFFF" Margin="0,0,0,16"/>

            <!-- Appearance -->
            <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}"/>

            <StackPanel Orientation="Horizontal" Margin="0,6">
                <TextBlock Text="Theme" Width="120" VerticalAlignment="Center"/>
                <ComboBox x:Name="ThemeCombo" Width="140">
                    <ComboBoxItem Content="Dark"/>
                    <ComboBoxItem Content="Light"/>
                </ComboBox>
            </StackPanel>

            <CheckBox x:Name="AutoTransparencyCheck" Content="Auto Transparency"/>

            <TextBlock Text="Normal Opacity" Margin="0,8,0,0"/>
            <Slider x:Name="NormalOpacitySlider" Minimum="0.30" Maximum="1.00"
                    TickFrequency="0.05" IsSnapToTickEnabled="True"/>

            <TextBlock Text="Idle Opacity"/>
            <Slider x:Name="IdleOpacitySlider" Minimum="0.15" Maximum="0.90"
                    TickFrequency="0.05" IsSnapToTickEnabled="True"/>

            <CheckBox x:Name="CompactModeCheck" Content="Compact Mode"/>

            <!-- Metrics -->
            <TextBlock Text="Metrics" Style="{StaticResource SectionHeader}"/>

            <TextBlock Text="Refresh Interval (ms)" Margin="0,8,0,0"/>
            <ComboBox x:Name="RefreshIntervalCombo" Width="140">
                <ComboBoxItem Content="500"/>
                <ComboBoxItem Content="1000"/>
                <ComboBoxItem Content="2000"/>
                <ComboBoxItem Content="5000"/>
            </ComboBox>

            <CheckBox x:Name="ShowCpuCheck" Content="CPU"/>
            <CheckBox x:Name="ShowMemoryCheck" Content="Memory"/>
            <CheckBox x:Name="ShowDiskCheck" Content="Disk"/>
            <CheckBox x:Name="ShowNetworkCheck" Content="Network"/>
            <CheckBox x:Name="ShowGpuCheck" Content="GPU"/>
            <CheckBox x:Name="ShowTemperatureCheck" Content="Temperature"/>

            <!-- Behavior -->
            <TextBlock Text="Behavior" Style="{StaticResource SectionHeader}"/>

            <CheckBox x:Name="TopmostCheck" Content="Always on Top"/>
            <CheckBox x:Name="CloseToTrayCheck" Content="Close to Tray"/>
            <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows"/>
            <CheckBox x:Name="MousePassthroughCheck" Content="Mouse Passthrough (Click-through)"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" Width="80" Height="32"
                        Style="{x:Null}"
                        Background="#FF45475A" Foreground="#FFCDD6F4"
                        Click="Cancel_Click" Margin="0,0,10,0"/>
                <Button Content="Save" Width="80" Height="32"
                        Style="{x:Null}"
                        Background="#FF89B4FA" Foreground="#FF1E1E2E"
                        FontWeight="SemiBold" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
